---
import QuizView from "../../components/QuizView.astro";
import QuizFallback from "../../components/QuizFallback.astro";
import Base from "../../layouts/Base.astro";
import { getLanguageFromPathname, LANGUAGES } from "../../libs/language";
import { getTranslations } from "../../libs/translations";

export function getStaticPaths() {
  return Object.keys(LANGUAGES).map((lang) => ({ params: { lang } }));
}

const language = getLanguageFromPathname(Astro.url.pathname);
const { title } = getTranslations(language);
---

<Base>
  <h1>{title}</h1>
  <QuizView language={language} server:defer>
    <QuizFallback slot="fallback" options={5} />
  </QuizView>
</Base>
