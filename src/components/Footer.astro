---
import { getLanguageFromPathname, LANGUAGES } from "../libs/language";
import { getTranslations } from "../libs/translations";

const language = getLanguageFromPathname(Astro.url.pathname);
const { ui } = getTranslations(language);

const isMultiChoice = Astro.url.pathname.includes("multi-choice");
const modes = [
  {
    href: `/${language}/`,
    isCurrent: !isMultiChoice,
    label: ui("singleChoice"),
  },
  {
    href: `/${language}/multi-choice`,
    isCurrent: isMultiChoice,
    label: ui("multipleChoice"),
  },
];
const suffix = isMultiChoice ? "multi-choice" : "";
---

<footer class="site-footer">
  <nav aria-label={ui("language")}>
    <span class="nav-label">{ui("language")}:</span>
    {Object.entries(LANGUAGES).map(([code, label]) => (
      <a
        href={`/${code}/${suffix}`}
        lang={code}
        aria-current={code === language ? "page" : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
  <nav aria-label={ui("mode")}>
    <span class="nav-label">{ui("mode")}:</span>
    {modes.map(({ href, isCurrent, label }) => (
      <a href={href} aria-current={isCurrent ? "page" : undefined}>
        {label}
      </a>
    ))}
  </nav>
</footer>
