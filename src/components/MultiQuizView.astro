---
import type { Language } from "../libs/language";
import { generateMultiChoiceQuiz } from "../libs/quiz";
import { getTranslations } from "../libs/translations";
import QuizStatements from "./QuizStatements.astro";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const { ui } = getTranslations(language);
const quiz = generateMultiChoiceQuiz(language);
---

<div
  data-quiz="multi"
  data-correct-label={ui("correct")}
  data-incorrect-label={ui("incorrect")}
>
  <QuizStatements language={language} sentences={quiz.baseSentences} />

  <form>
    <fieldset class="options">
      <legend class="visually-hidden">{ui("multipleChoice")}</legend>
      {quiz.answers.map((answer) => (
        <label class="option" data-correct={String(answer.isCorrect)}>
          <input type="checkbox" name="option" />
          <span class="option-text">{answer.sentence}</span>
          <span class="option-status" />
        </label>
      ))}
    </fieldset>

    <div class="actions">
      <button type="submit" class="button">
        {ui("checkAnswers")}
      </button>
      <a href={`/${language}/multi-choice`} class="button button-secondary">
        {ui("newQuestion")}
      </a>
    </div>
  </form>
</div>

<script>
  import "../scripts/quiz";
</script>
