---
import type { Language } from "../libs/language";
import { getTranslations } from "../libs/translations";

interface Props {
  language: Language;
  sentences: string[];
}

const { language, sentences } = Astro.props;
const { ui } = getTranslations(language);
---

<div class="statements">
  {sentences.map((sentence, index) => (
    <p class="statement">
      <span class="statement-label">
        {ui(index === 0 ? "statement1" : "statement2")}
      </span>
      <span class="statement-text">{sentence}</span>
    </p>
  ))}
</div>
