---
import "@fontsource-variable/atkinson-hyperlegible-next";
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import { getLanguageFromPathname } from "../libs/language";
import { getTranslations } from "../libs/translations";

const language = getLanguageFromPathname(Astro.url.pathname);
const { title } = getTranslations(language);
const imageUrl = new URL("/og-image.png", Astro.site ?? Astro.url);
const description =
  "Train your logical understanding of implications with randomized single and multiple choice questions.";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site ?? Astro.url)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Implications Trainer: Practise deriving statements from statements."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <main class="main-content" id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .visually-hidden {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  .skip-link {
    background: #000;
    color: #fff;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    padding: 0.5rem 0.75rem;
    position: absolute;
    transform: translateY(-200%);
    z-index: 2000;
  }

  .skip-link:focus {
    transform: none;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family:
      "Atkinson Hyperlegible Next Variable",
      system-ui,
      -apple-system,
      sans-serif;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    color: #ffffff;
    min-height: 100vh;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.6;
    font-size: 16px;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 3rem;
    background: linear-gradient(135deg, #ffffff 0%, #e0e0e0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 2px 10px rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
      margin-bottom: 2rem;
    }

    .main-content {
      padding: 1.5rem 1rem;
    }
  }
</style>
