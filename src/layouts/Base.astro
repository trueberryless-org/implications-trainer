---
import "@fontsource-variable/atkinson-hyperlegible-next";
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import { getLanguageFromPathname } from "../libs/language";
import { getTranslations } from "../libs/translations";

const language = getLanguageFromPathname(Astro.url.pathname);
const { title } = getTranslations(language);
const imageUrl = new URL("/og-image.png", Astro.site ?? Astro.url);
const description =
  "Train your logical understanding of implications with randomized single and multiple choice questions.";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site ?? Astro.url)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Implications Trainer: Practise deriving statements from statements."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
